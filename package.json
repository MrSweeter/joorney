{
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "prod": "npm run clean-build && NODE_ENV=production npm run build && npm run zip",
        "zip": "node scripts/zip_bundle.js",
        "build": "rollup -c",
        "dev": "rollup -c -w",
        "build:lite": "rollup -c rollup.lite.config.mjs",
        "dev:lite": "rollup -c rollup.lite.config.mjs -w",
        "prod:lite": "NODE_ENV=production npm run build:lite && node scripts/zip_lite.js",
        "clean-build": "rm -rf ./bundle && rm -rf ./docs",
        "cloc": "cloc --exclude-dir=node_modules,bundle,docs,lib ."
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@types/node": "^24.19.2",
        "archiver": "^8.0.0",
        "rollup": "^4.67.2",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-watch-assets": "^1.0.1"
    }
}
